# =====================================================================
# Voluntiva — variáveis de ambiente
#
# COPIE ESTE ARQUIVO:  cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser commitado.
# Este .env.example é versionado e não pode conter valores reais.
# =====================================================================

# ---------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
DEBUG=true

# ---------------------------------------------------------------------
# Banco de dados — Supabase (projeto Voluntiva-Proj)
#
# Onde achar: Supabase > Project Settings > Database > Connection string
# Use a porta 5432 (Session pooler) e NÃO a 6543 (Transaction pooler):
# o pooler transacional não mantém a sessão entre statements, o que quebra
# o SELECT ... FOR UPDATE do controle de lotação.
#
# Formato psycopg3:
#   postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres
#
# Se a senha tiver caracteres especiais (@ : / ?), faça URL-encode.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Banco local para rodar os testes (docker compose sobe este serviço).
# Os testes NUNCA devem apontar para o Supabase compartilhado da equipe.
TEST_DATABASE_URL=postgresql+psycopg://voluntiva:voluntiva@localhost:5433/voluntiva_test

# Tamanho do pool de conexões da aplicação
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------
# Autenticação JWT
#
# Gere um segredo novo e único por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Não reaproveite o segredo de desenvolvimento em produção e não
# compartilhe o mesmo valor entre integrantes da equipe.
# ---------------------------------------------------------------------
JWT_SECRET=troque-por-um-segredo-gerado-aleatoriamente
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# API HTTP (FastAPI)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Origens liberadas no CORS, separadas por vírgula.
# Em produção, liste os domínios explicitamente — nunca use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Servidor TCP — protocolo VAP (Voluntiva Application Protocol)
# Nomes conforme protocol/config.py. Ver docs/VAP.md.
# ---------------------------------------------------------------------
VAP_HOST=127.0.0.1
VAP_PORT=5050

# Limites de mensagem (padrão 64 KB, conforme docs/VAP.md seção 6)
VAP_MAX_MESSAGE_SIZE=65536

# Timeouts em segundos. auth_timeout é o prazo para o cliente enviar AUTH
# depois de conectar; sem ele um socket ocioso segura recurso de graça.
VAP_AUTH_TIMEOUT=30
VAP_IDLE_TIMEOUT=120
VAP_MESSAGE_TIMEOUT=30
VAP_WRITE_TIMEOUT=5

# Controle de abuso
VAP_MAX_CONNECTIONS=64
VAP_MAX_CONNECTIONS_PER_IP=8
VAP_MAX_REQUESTS_PER_CONNECTION=1000
VAP_MAX_REQUESTS_PER_SECOND=50
VAP_MAX_AUTH_FAILURES=3

# TLS — obrigatório em produção (docs/VAP.md seção 1: VAP sobre TLS sobre
# TCP). Sem TLS o JWT do comando AUTH trafega em texto claro na rede.
VAP_USE_TLS=false
VAP_CERTFILE=
VAP_KEYFILE=

# ---------------------------------------------------------------------
# Supabase — chaves de API
#
# Só são necessárias se vocês usarem Storage ou a API REST.
# O acesso ao banco é feito por DATABASE_URL via SQLAlchemy, então
# deixe em branco enquanto não houver upload de arquivos.
#
# A service_role key ignora RLS: nunca a exponha no frontend.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Segurança de senhas
# Parâmetros do Argon2id. Valores menores só em ambiente de teste.
# ---------------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
