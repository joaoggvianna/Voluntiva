# Frontend — copie para .env.local (que está no .gitignore)
#
# Só variáveis com prefixo VITE_ chegam ao navegador. Elas vão para o
# bundle em texto claro: NUNCA coloque aqui segredo, service_role key
# do Supabase ou senha de banco.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
